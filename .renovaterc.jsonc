{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "assignees": ["davide"],
  "extends": [
    "config:best-practices",
    "customManagers:dockerfileVersions",
    "customManagers:biomeVersions",
    ":semanticCommits"
  ],
  "packageRules": [
    // Automerge and group devcontainer, actions and ci deps.
    {
      "automerge": true,
      "groupName": "CI dependencies",
      "groupSlug": "ci",
      "matchFileNames": [".devcontainer/**", ".forgejo/**"],
      "matchUpdateTypes": ["!major"],
      "semanticCommitType": "ci"
    },
    // Also group the pnpm in the packageManager in package.json.
    {
      "automerge": true,
      "groupName": "CI dependencies",
      "groupSlug": "ci",
      "matchPackageNames": ["pnpm"],
      "semanticCommitType": "ci"
    },
    // Automerge linters and formatters.
    {
      "automerge": true,
      "matchPackageNames": ["@biomejs/biome", "@types/node", "rolldown", "typescript"],
      "matchUpdateTypes": ["!major"],
      "semanticCommitType": "chore"
    }
  ],
  "prHourlyLimit": 4
}
