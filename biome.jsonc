{
  "$schema": "https://biomejs.dev/schemas/2.6.3/schema.json",
  "files": {
    "includes": ["**", "!pnpm-lock.yaml"]
  },
  "formatter": {
    "indentStyle": "space",
    "indentWidth": 2,
    "lineWidth": 120
  },
  "linter": {
    "domains": {
      "project": "recommended",
      "types": "recommended"
    },
    "rules": {
      "complexity": {
        "noForEach": "warn",
        "noUselessReturn": "warn",
        "noUselessStringConcat": "warn"
      },
      "correctness": {
        "useImportExtensions": "warn"
      },
      "nursery": {
        "noAccidentalBitwiseOperators": "error",
        "noFloatingPromises": "error",
        "noMeaninglessVoidOperator": "error",
        "noMisleadingReturnType": "warn",
        "noMisusedPromises": "error",
        "noObsoleteTags": "warn",
        "noUselessAssignment": "info",
        "useAwaitThenable": "warn",
        "useExhaustiveSwitchCases": "info"
      },
      "performance": {
        // Useful ot check once in a while.
        // "noAwaitInLoops": "warn"
      },
      "style": {
        "useAsConstAssertion": "warn",
        "useConsistentBuiltinInstantiation": "warn",
        "useImportsFirst": "warn"
      },
      "suspicious": {
        "noForIn": "error",
        "noUnassignedVariables": "warn",
        "noVar": "warn",
        "useAwait": "warn"
      }
    }
  },
  "vcs": {
    "clientKind": "git",
    "enabled": true,
    "useIgnoreFile": true
  }
}
